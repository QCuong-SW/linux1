# Copy to /opt/miniflow/.miniflow/operations.env; owned by deploy, mode 600.
MINIFLOW_PUBLIC_URL=https://app.your-domain.com
# Pre-create the destination and verify its SSH host key before enabling this.
# MINIFLOW_BACKUP_REMOTE=backup@backup-host:/srv/backups/miniflow/
# Optional HTTPS webhook receiving JSON {"text": "..."}, e.g. a Slack incoming webhook.
# MINIFLOW_ALERT_WEBHOOK=https://your-webhook-url
MINIFLOW_DISK_LIMIT=85
MINIFLOW_MEMORY_LIMIT=90
