[Unit]
Description=MiniFlow app and host health check
After=docker.service network-online.target
Wants=network-online.target
OnFailure=miniflow-notify@%n.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/miniflow
EnvironmentFile=/opt/miniflow/.miniflow/operations.env
ExecStart=/usr/bin/bash /opt/miniflow/infra/scripts/health-check.sh
UMask=0077
